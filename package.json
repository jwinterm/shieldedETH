{
  "name": "shieldedeth",
  "version": "0.8.0",
  "private": true,
  "description": "ShieldedETH v0.8 local research implementation",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "build:contracts": "node scripts/build-contracts.js",
    "build:circuits": "node scripts/build-circuits.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "test:circuits": "node --max-old-space-size=18000 tests/circuits.js",
    "test:integration": "node tests/integration.js",
    "bench": "node tests/integration.js",
    "docs": "node scripts/update-evidence.js"
  },
  "overrides": {
    "tmp": "0.2.7",
    "ws": "8.21.0",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@ethereumjs/block": "5.3.0",
    "@ethereumjs/common": "4.4.0",
    "@ethereumjs/tx": "5.4.0",
    "@ethereumjs/util": "9.1.0",
    "@ethereumjs/vm": "8.1.1",
    "@noble/ciphers": "1.0.0",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "ethers": "5.8.0",
    "ffjavascript": "0.3.1",
    "snarkjs": "0.7.5",
    "solc": "0.8.26"
  }
}
